{
  "name": "@gourmet-box/api", "private": true, "version": "0.1.0", "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --env-file=../../.env dist/src/main.js",
    "start": "node --env-file=../../.env dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "db:migrate": "tsc -p tsconfig.json && node --env-file=../../.env dist/src/migrate.js",
    "db:seed": "tsc -p tsconfig.json && node --env-file=../../.env dist/src/seed-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0", "@nestjs/platform-express": "^11.1.0",
    "jose": "^6.1.0", "pg": "^8.16.0", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2",
    "helmet": "^8.1.0", "express-rate-limit": "^8.1.0", "yaml": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0", "@types/node": "^24.0.0", "@types/pg": "^8.15.0",
    "@types/express": "^5.0.0", "@electric-sql/pglite": "^0.3.0"
  }
}
