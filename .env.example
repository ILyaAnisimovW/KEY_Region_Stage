# Run npm run demo:setup to generate a local .env with random passwords.
PORT=3000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
WEB_ORIGIN=http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/gourmet-box
OIDC_JWKS_URL=http://localhost:8080/realms/gourmet-box/protocol/openid-connect/certs
OIDC_AUDIENCE=gourmet-box-api
PICKUP_CODE_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_SECRET
DATABASE_URL=postgresql://gourmet:CHANGE_ME@localhost:5432/gourmet
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
